DATABASE_URL=postgresql+psycopg://ingest:ingest@localhost:5432/ingest_farm
REDIS_URL=redis://localhost:6379/0
STORAGE_ROOT=./data/recordings
API_HOST=0.0.0.0
API_PORT=8080
WORKER_ID=
WORKER_CAPACITY=4

# --- GStreamer ---
# Extra plugin dir (optional). Native GST_PLUGIN_PATH is also honoured.
GST_PLUGIN_PATH=

# SRT listener defaults. A latency= query on the channel URI always wins.
# Handshake/ARQ window — must match the caller. Not the capture-buffer delay.
GST_SRT_LATENCY_MS=500
GST_SRT_WAIT_FOR_CONNECTION=true
GST_SRT_KEEP_LISTENING=true
# Listener verdict for incoming callers. false rejects every caller (no OBS).
GST_SRT_AUTHENTICATION=true

# ETR 290 (TSDuck tsp on SRT live sessions). Requires tsp in the worker image.
ETR290_ENABLED=true
ETR290_INTERVAL_SEC=2
# Monitor tap queue: leaky so tsp cannot stall ingest, sized so CC errors
# are not invented by a 8-buffer preview queue.
ETR290_QUEUE_MS=2000
ETR290_QUEUE_BYTES=8388608
ETR290_QUEUE_BUFFERS=0
ETR290_QUEUE_LEAKY=upstream

# UDP MPEG-TS / RTP. Larger socket + jitter buffer absorbs bursts without drops.
GST_UDP_BUFFER_SIZE=8388608
GST_RTP_JITTERBUFFER_MS=1000

# Ingest queues. leaky: none | upstream (drop when full) | downstream
# Passthrough sits BEFORE the record tee — never leak (holes in the master).
# Byte cap makes the queue actually fill when live TS timestamps are junk.
# Preview MUST leak (and has buffer/byte limits) so JPEG decode cannot stall capture.
GST_PASSTHROUGH_QUEUE_MS=30000
GST_PASSTHROUGH_QUEUE_BYTES=67108864
GST_PASSTHROUGH_QUEUE_BUFFERS=0
GST_PASSTHROUGH_LEAKY=none
GST_PREVIEW_QUEUE_MS=250
GST_PREVIEW_QUEUE_BYTES=1048576
GST_PREVIEW_QUEUE_BUFFERS=8
GST_PREVIEW_LEAKY=upstream
GST_TEE_ALLOW_NOT_LINKED=true

# MPEG-TS alignment on the record branch (tsparse). 7 = 188-byte packets.
GST_TSPARSE_SET_TIMESTAMPS=true
GST_TSPARSE_ALIGNMENT=7

# Live JPEG preview (IDR/keyframe grabs when GST_THUMB_IDR_ONLY=true)
GST_THUMB_WIDTH=640
GST_THUMB_HEIGHT=360
GST_THUMB_JPEG_QUALITY=85
GST_THUMB_INTERVAL_SEC=1.0
GST_THUMB_IDR_ONLY=true
GST_PARSE_CONFIG_INTERVAL=-1

# HLS web proxy + catalog poster (post-process worker)
# Do not set GST_PROXY_X264_TUNE=zerolatency — it skips frames on VOD.
GST_PROXY_WIDTH=640
GST_PROXY_HEIGHT=360
GST_PROXY_BITRATE_KBPS=800
GST_PROXY_KEY_INT_MAX=200
GST_PROXY_X264_TUNE=
GST_PROXY_X264_SPEED_PRESET=veryfast
GST_PROXY_HLS_TARGET_DURATION=4
GST_PROXY_TIMEOUT_SEC=1800
GST_POSTER_JPEG_QUALITY=85
GST_POSTER_TIMEOUT_SEC=60
GST_DISCOVERER_TIMEOUT_SEC=5
